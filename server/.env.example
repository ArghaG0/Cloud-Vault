# Server Port & Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_this_to_a_random_string
JWT_EXPIRES_IN=7d

# Database (MongoDB Atlas / Local)
# Cloud: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/cloudvault?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/cloudvault
MONGODB_URI=your_mongodb_connection_string_here

# AWS S3 Storage Configuration
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=your_s3_bucket_name_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: Set to true if you want to test APIs locally without AWS S3 connection
OFFLINE_MODE=false
